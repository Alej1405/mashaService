# Worker de la cola del ERP.
#
# Sin esto, una declaración pedida se queda en "pendiente" para siempre: el job
# entra a la tabla jobs y nadie lo saca.
#
# Va en el servidor del ERP (138.68.45.117), NO en el de microservicios.
# Se instala una vez, desde /var/www/erp.mashaec.net:
#
#   sudo cp deploy/erp-queue.service /etc/systemd/system/erp-queue.service
#   sudo systemctl daemon-reload && sudo systemctl enable --now erp-queue
#
# El despliegue ya corre `php artisan queue:restart`, así que tras cada push el
# worker toma el código nuevo solo. No hay que reiniciar el servicio a mano.
[Unit]
Description=Cola del ERP MashaCorp
After=network.target postgresql.service

[Service]
# El mismo usuario que despliega y ya escribe en storage/.
User=alej1405mc
Group=www-data
Restart=always
RestartSec=5
WorkingDirectory=/var/www/erp.mashaec.net
# --max-time recicla el proceso cada hora: evita que un worker viejo se quede
# con código y conexiones antiguas.
ExecStart=/usr/bin/php artisan queue:work database --queue=default --sleep=3 --tries=3 --max-time=3600
StandardOutput=append:/var/log/erp-queue.log
StandardError=append:/var/log/erp-queue.log

[Install]
WantedBy=multi-user.target
